# ── Supabase ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sbp_...        # service_role: escrituras server-side (orders, events, costos)

# ── Claves de API internas ──
CATALOG_API_KEY=                    # Bearer de SOLO LECTURA para el agente (GET /api/catalog, /api/meta, /api/dashboard)
META_WRITE_KEY=                     # Bearer de ESCRITURA Meta (POST /api/meta: pausar/crear/presupuesto). NO usar el de lectura
ADMIN_SESSION_SECRET=              # Secreto largo para firmar la cookie httpOnly del panel admin
ADMIN_API_KEY=                     # DEPRECATED — el panel usa sesión httpOnly (ADMIN_SESSION_SECRET + ADMIN_PIN); dejar vacío
ADMIN_PIN=                          # PIN de acceso al panel (mínimo 8 caracteres)
CRON_SECRET=                        # Bearer que Vercel Cron manda a /api/orders?cron=reconciliar (fail-closed)

# ── Wompi (pagos) ──
WOMPI_PRIVATE_KEY=prv_prod_...
WOMPI_INTEGRITY_SECRET=             # Secreto de Integridad (firma del Web Checkout). NO es el private key
WOMPI_WEBHOOK_SECRET=              # Secreto compartido para validar webhooks de Wompi

# ── Bold (pagos) ──
BOLD_API_KEY=                       # Llave de identidad de PRODUCCIÓN (empieza H_)
BOLD_WEBHOOK_SECRET=              # Secreto para validar webhooks de Bold

# ── Addi (crédito BNPL) ──
ADDI_CLIENT_ID=
ADDI_CLIENT_SECRET=
ADDI_ENV=production                 # production | staging
ADDI_WEBHOOK_USER=                 # Basic auth del webhook Addi (fail-closed: requerido para auto-confirmar)
ADDI_WEBHOOK_PASS=
ADDI_WEBHOOK_SECRET=               # Alternativa al Basic auth: secreto por header x-webhook-secret

# ── Sistecrédito (crédito BNPL) ──
SISTECREDITO_SUBSCRIPTION_KEY=
SISTECREDITO_VENDOR_ID=

# ── Meta Ads / Pixel / CAPI ──
META_USER_TOKEN=EAAT...             # token de la Graph API (insights + CAPI fallback)
META_CAPI_TOKEN=                    # token dedicado del CAPI (opcional; si falta usa META_USER_TOKEN)
META_PIXEL_ID=                      # Pixel canónico (debe coincidir con settings.pixel_id del front)
META_AD_ACCOUNT_ID=act_...
META_BUSINESS_ID=                   # Business ID (Settings → Business Info)

# ── Google AI (Gemini) — ai-photo ──
GEMINI_API_KEY=AIza...

# ── Vercel KV (rate-limit distribuido; opcional, si falta usa memoria en proceso) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Telegram (aviso de venta; opcional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── General ──
STORE_URL=https://strangesneakers.com
