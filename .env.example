# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sbp_...

# Claves de API internas
CATALOG_API_KEY=           # Bearer token para el agente de IA (catalog + meta endpoints)
ADMIN_SESSION_SECRET=      # Secreto largo para firmar la cookie httpOnly del panel admin

# Wompi pagos
WOMPI_PRIVATE_KEY=prv_prod_...
WOMPI_WEBHOOK_SECRET=      # Secreto compartido para validar webhooks de Wompi

# Google AI (Gemini)
GEMINI_API_KEY=AIza...

# Bold pagos
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# Meta Ads API
META_USER_TOKEN=EAAT...
META_AD_ACCOUNT_ID=act_...
META_BUSINESS_ID=               # Business ID de Meta (Settings → Business Info → Business ID)

# Admin panel
ADMIN_PIN=                      # PIN de acceso al panel de administrador (mínimo 6 caracteres)

# General
STORE_URL=https://catalogo.tudominio.com
